{
  "manifest_version": 2,
  "id": "local.wardrobe",
  "version": "1.3.0",
  "name": "衣柜 | Wardrobe",
  "description": "给麦麦本体一个虚拟衣柜：每日按分享欲决定穿搭与晒图，聊天中可查看衣柜、买新衣、聊穿搭，WebUI 专属页面维护衣服。",
  "author": {
    "name": "pankai",
    "url": "https://github.com/Langwing"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/Langwing/maibot-wardrobe"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "tomlkit",
      "version_spec": ">=0.12.0"
    }
  ],
  "capabilities": [
    "chat.get_stream_by_user_id",
    "chat.open_session",
    "maisaka.context.append",
    "maisaka.proactive.trigger"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": [
      "zh-CN"
    ]
  }
}
